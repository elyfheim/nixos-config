background = #191d24
font-size = 11
font-feature = -calt, -liga, -dlig
command = /run/current-system/sw/bin/fish --login
window-padding-x = 6
window-padding-y = 6

keybind = ctrl+j=goto_split:next
keybind = ctrl+k=goto_split:previous

keybind = ctrl+w=close_surface
keybind = ctrl+enter=new_split:down

